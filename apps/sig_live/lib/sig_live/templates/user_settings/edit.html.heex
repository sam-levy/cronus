<div class="flex items-center justify-center min-h-screen">
  <div class="px-8 py-6 w-2/6 bg-white shadow-lg">
    <h1 class="text-xl text-gray-600 font-bold text-center">Alteração de Senha</h1>

    <.form let={f} for={@password_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_password" class="flex flex-col space-y-5">
      <%= hidden_input f, :action, name: "action", value: "update_password" %>

      <%= password_input f, :current_password, required: true, name: "current_password", id: "current_password_for_password", class: "form-input", placeholder: "Senha atual" %>
      <%= error_tag f, :current_password %>

      <%= password_input f, :password, required: true, class: "form-input", placeholder: "Nova senha" %>
      <%= error_tag f, :password %>

      <%= password_input f, :password_confirmation, required: true, class: "form-input", placeholder: "Confirmação" %>
      <%= error_tag f, :password_confirmation %>

      <div class="flex justify-end">
        <%= submit "Alterar", class: "btn-blue" %>
      </div>
    </.form>
  </div>
</div>
